{
  "name": "finanzmoench-e2e",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "mail:up": "docker compose -f ../docker-compose.e2e.yaml up -d",
    "mail:down": "docker compose -f ../docker-compose.e2e.yaml down",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:5173"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}
